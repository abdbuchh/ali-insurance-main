# Resend — https://resend.com/api-keys
RESEND_API_KEY=

# Where quote requests are delivered (any inbox you own)
QUOTE_TO_EMAIL=insurance.ali@pm.me

# Use quotes in .env files when the value contains spaces or <>
# Must use your verified Resend domain (quotes@... does not need a real mailbox)
EMAIL_FROM="Ali Insurance Agency <quotes@aliinsuranceagency.com>"

# Vercel (Project → Settings → Environment Variables → Production):
# Paste values WITHOUT quotes, e.g. Ali Insurance Agency <quotes@aliinsuranceagency.com>
# Enable for Production, Preview, and Development, then redeploy.

# Local dev with working contact form:
#   npm run dev:full
# UI-only (form /api/quote will 404):
#   npm run dev
