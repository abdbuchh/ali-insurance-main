# Resend — https://resend.com/api-keys
RESEND_API_KEY=

# Where quote requests are delivered
QUOTE_TO_EMAIL=you@example.com

# Use quotes when the value contains spaces or <>
# Testing: onboarding@resend.dev only sends to your Resend account email
EMAIL_FROM="Ali Alawlaqi <onboarding@resend.dev>"

# Local dev with working contact form:
#   npm run dev:full
