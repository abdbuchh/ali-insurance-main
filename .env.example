# Resend — https://resend.com/api-keys
RESEND_API_KEY=

# Where quote requests are delivered
QUOTE_TO_EMAIL=you@example.com

# Use quotes in .env files when the value contains spaces or <>
# Testing: onboarding@resend.dev only sends to your Resend account email
EMAIL_FROM="Ali Alawlaqi <onboarding@resend.dev>"

# Vercel (Project → Settings → Environment Variables → Production):
# Paste values WITHOUT quotes, e.g. Quote Request <onboarding@resend.dev>
# Enable for Production, Preview, and Development, then redeploy.

# Local dev with working contact form:
#   npm run dev:full
# UI-only (form /api/quote will 404):
#   npm run dev
